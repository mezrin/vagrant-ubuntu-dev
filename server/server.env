# Inputs for server/setup.sh: an x86_64 Ubuntu 26.04 development server set up
# like the Vagrant guest. Sourced by Bash. Versions match the Vagrantfile; only
# architecture-specific URLs and digests, networking, and identity differ.
# When updating an archive, update its version, URL, and SHA-256 together.

# Identity. DEFAULT_USER is the account that runs setup.sh (not root).
VM_NAME="$(hostname --short)"
DEFAULT_USER="$(id --user --name)"
GIT_USER_EMAIL="victor.mezrin@trevo.finance"
GIT_USER_NAME="Victor Mezrin"
GIT_CORE_EDITOR="code --wait"
GITHUB_SSH_IDENTITY_FILE="~/.ssh/github_dev-10_mezrin_ed25519"
INOTIFY_MAX_USER_WATCHES="524288"
INOTIFY_MAX_USER_INSTANCES="1024"

# Networking. There is no host-only network: services bind to loopback and are
# reached through SSH port forwarding. Only SSH and these ports are public.
PRIVATE_NETWORK_IP="127.0.0.1"
SERVER_PUBLIC_TCP_PORTS=""
DOCKER_INGRESS_POLICY="public-server"

# Ubuntu packages: the Vagrant baseline and development packages, without the
# desktop, NetworkManager (this server uses systemd-networkd), LVM growth tools,
# and Nginx.
OS_APT_PACKAGES="ca-certificates curl gnupg openssl unattended-upgrades ufw \
  build-essential gcc cmake clang libssl-dev protobuf-compiler git colordiff"

# GitHub CLI
GITHUB_CLI_VERSION="2.94.0"
GITHUB_CLI_ARCHIVE_SHA256="a757f1ba6db18f4de8cbadb244843a5f89bc75b5e7c6fc127d2bd77fbd12ed62"
GITHUB_CLI_ARCHIVE_URL="https://github.com/cli/cli/releases/download/v$GITHUB_CLI_VERSION/gh_${GITHUB_CLI_VERSION}_linux_amd64.tar.gz"

# Docker
DOCKER_APT_KEY_SHA256="1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570"
DOCKER_APT_KEY_URL="https://download.docker.com/linux/ubuntu/gpg"
DOCKER_APT_REPOSITORY_URL="https://download.docker.com/linux/ubuntu"
DOCKER_CE_VERSION="5:29.7.1-1~ubuntu.26.04~resolute"
DOCKER_CONTAINERD_VERSION="2.2.6-1~ubuntu.26.04~resolute"
DOCKER_BUILDX_VERSION="0.36.0-1~ubuntu.26.04~resolute"
DOCKER_COMPOSE_VERSION="5.3.1-1~ubuntu.26.04~resolute"
DOCKER_DEFAULT_NOFILE_LIMIT="64000"

# Rust
RUSTUP_VERSION="1.29.0"
RUSTUP_INIT_SHA256="4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10"
RUSTUP_INIT_URL="https://static.rust-lang.org/rustup/archive/$RUSTUP_VERSION/x86_64-unknown-linux-gnu/rustup-init"
RUST_STABLE_TOOLCHAIN="1.97.1"
RUST_NIGHTLY_TOOLCHAIN="nightly-2026-07-31"

# Python
UV_VERSION="0.11.16"
UV_ARCHIVE_SHA256="74947fe2c03315cf07e82ab3acc703eddef01aba4d5232a98e4c6825ec116131"
UV_ARCHIVE_URL="https://github.com/astral-sh/uv/releases/download/$UV_VERSION/uv-x86_64-unknown-linux-gnu.tar.gz"
PYTHON_VERSIONS="3.12.13 3.13.12"

# Node.js
NVM_VERSION="v0.40.6"
NVM_ARCHIVE_SHA256="17302cad7feedb1ad33ba738f93d2176a90970724f22de119603624fcbdec1a2"
NVM_ARCHIVE_URL="https://github.com/nvm-sh/nvm/archive/refs/tags/$NVM_VERSION.tar.gz"
NODE_VERSION="v22.23.2"
NODE_ARCHIVE_SHA256="b294a556e639d64338823920e5866c21c02741742d2e1529ee1a225c1ec9252a"
NODE_ARCHIVE_URL="https://nodejs.org/download/release/$NODE_VERSION/node-$NODE_VERSION-linux-x64.tar.gz"
COREPACK_VERSION="0.35.0"
COREPACK_ARCHIVE_SHA256="f62535fc7be1f77e4b12cd1e420b8542b8e895cbb14178926963a41a9232a4fe"
COREPACK_ARCHIVE_URL="https://registry.npmjs.org/corepack/-/corepack-$COREPACK_VERSION.tgz"

# PostgreSQL
POSTGRESQL_APT_KEY_SHA256="0144068502a1eddd2a0280ede10ef607d1ec592ce819940991203941564e8e76"
POSTGRESQL_APT_KEY_URL="https://www.postgresql.org/media/keys/ACCC4CF8.asc"
POSTGRESQL_APT_REPOSITORY_URL="https://apt.postgresql.org/pub/repos/apt"
POSTGRESQL_MAJOR_VERSION="18"
POSTGRESQL_PACKAGE_VERSION="18.4-1.pgdg26.04+1"
POSTGRESQL_ALLOW_PACKAGE_DOWNGRADE="false"

# MongoDB. The password is read from MONGODB_PASSWORD or .secrets/mongodb-password
# (generated on first run). The replica member is localhost so both the
# container and host-side clients resolve it to this mongod.
MONGODB_IMAGE="mongo:7.0.39@sha256:9bdaeb6dac6e7e762e84e2f84103d1f9bb078fa1ba6bde8bb9d2274f655ad173"
MONGODB_CONTAINER="mongodb"
MONGODB_VOLUME="mongodb-data"
MONGODB_PORT="27017"
MONGODB_REPLICA_SET="rs0"
MONGODB_REPLICA_MEMBER="localhost:$MONGODB_PORT"
MONGODB_USERNAME="vagrant"
MONGODB_AUTH_DATABASE="admin"
MONGODB_PASSWORD_ENVIRONMENT_VARIABLE="MONGODB_PASSWORD"
MONGODB_SECRETS_DIRECTORY="/etc/mongodb-secrets"
MONGODB_CONFIG_VERSION="authenticated-private-v1"
MONGODB_MANAGED_LABEL="dev.vagrant.mongodb-managed"
MONGODB_CONFIG_LABEL="dev.vagrant.mongodb-config"
MONGODB_CONFIG_DIGEST_LABEL="dev.vagrant.mongodb-config-digest"
MONGODB_STOP_TIMEOUT_SECONDS="60"
MONGODB_READY_ATTEMPTS="60"
MONGODB_HEALTH_ATTEMPTS="30"
MONGODB_RETRY_DELAY_SECONDS="2"
MONGODB_HEALTH_INTERVAL="10s"
MONGODB_HEALTH_TIMEOUT="10s"
MONGODB_HEALTH_START_PERIOD="180s"
MONGODB_HEALTH_RETRIES="12"
MONGODB_DIAGNOSTIC_LOG_LINES="200"
MONGODB_NOFILE_LIMIT="$DOCKER_DEFAULT_NOFILE_LIMIT"
